-- =========================================================

create or replace function public.complete_signup(
  _full_name text,
  _governorate_id uuid,
  _phone text,
  _role text,
  _office jsonb default null
)
returns void
language plpgsql
security definer
set search_path = public, auth
as $$
declare
  v_uid uuid := auth.uid();
  v_email text;
  v_office_id uuid;
  v_plan_code text;
  v_package_id uuid;
begin

  if v_uid is null then
    raise exception 'not_authenticated';
  end if;

  if _role not in ('individual', 'office') then
    raise exception 'invalid_role';
  end if;

  if _governorate_id is not null
     and not exists (
       select 1
       from public.governorates g
       where g.id = _governorate_id
         and g.is_active = true
     )
  then
    raise exception 'governorate_inactive';
  end if;

  select email
  into v_email
  from auth.users
  where id = v_uid;

  insert into public.profiles (
    id,
    full_name,
    phone,
    email,
    governorate_id
  )
  values (
    v_uid,
    coalesce(nullif(trim(_full_name), ''), 'مستخدم'),
    nullif(trim(_phone), ''),
    v_email,
    _governorate_id
  )
  on conflict (id)
  do update set
    full_name = excluded.full_name,
    phone = excluded.phone,
    email = excluded.email,
    governorate_id = excluded.governorate_id,
    updated_at = now();

  insert into public.user_roles (
    user_id,
    role
  )
  values (
    v_uid,
    _role
  )
  on conflict (user_id, role) do nothing;

  if _role = 'office' then

    v_plan_code :=
      case
        when coalesce(_office->>'plan', 'free') = 'pro'
          then 'pro'
        else 'free'
      end;

    select id
    into v_package_id
    from public.package_catalog
    where code = v_plan_code
    limit 1;

    select id
    into v_office_id
    from public.offices
    where owner_id = v_uid
      and is_deleted = false
    order by created_at
    limit 1;

    if v_office_id is null then

      insert into public.offices (
        owner_id,
        name,
        manager_name,
        phone,
        email,
        address,
        license_number,
        commercial_register,
        governorate_id,
        plan,
        plan_started_at,
        plan_expires_at,
        verification_status,
        is_deleted,
        package_id
      )
      values (
        v_uid,
        coalesce(
          nullif(trim(_office->>'name'), ''),
          nullif(trim(_full_name), ''),
          'مكتب عقاري'
        ),
        nullif(trim(_office->>'manager_name'), ''),
        nullif(trim(_phone), ''),
        v_email,
        nullif(trim(_office->>'address'), ''),
        nullif(trim(_office->>'license_number'), ''),
        nullif(trim(_office->>'commercial_register'), ''),
        _governorate_id,
        v_plan_code::public.office_plan,
        now(),
        case
          when v_plan_code = 'pro'
            then now() + interval '30 days'
          else null
        end,
        'pending'::public.verification_status,
        false,
        v_package_id
      )
      returning id into v_office_id;

    else

      update public.offices
      set
        name = coalesce(
          nullif(trim(_office->>'name'), ''),
          nullif(trim(_full_name), ''),
          name
        ),
        manager_name = coalesce(
          nullif(trim(_office->>'manager_name'), ''),
          manager_name
        ),
        phone = coalesce(nullif(trim(_phone), ''), phone),
        email = coalesce(v_email, email),
        address = coalesce(
          nullif(trim(_office->>'address'), ''),
          address
        ),
        license_number = coalesce(
          nullif(trim(_office->>'license_number'), ''),
          license_number
        ),
        commercial_register = coalesce(
          nullif(trim(_office->>'commercial_register'), ''),
          commercial_register
        ),
        governorate_id = _governorate_id,
        package_id = coalesce(v_package_id, package_id),
        updated_at = now()
      where id = v_office_id;

    end if;

  end if;

end;
$$;

