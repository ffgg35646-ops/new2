# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=aqar_albatin

# Server session signing secret (32+ characters)
JWT_SECRET=

# Protects the scheduled task that sends Pro expiry notices and downgrades expired plans
CRON_SECRET=

# Personal email SMTP (example: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional initial administrator (used only by npm run seed:mongo)
MONGODB_ADMIN_EMAIL=
MONGODB_ADMIN_PASSWORD=
MONGODB_ADMIN_NAME=مدير النظام

# HyperPay
HYPERPAY_BASE_URL=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=

# Optional: seed a verified Pro office test account
MONGODB_TEST_OFFICE_EMAIL=
MONGODB_TEST_OFFICE_PASSWORD=
MONGODB_TEST_OFFICE_NAME=مكتب اختبار احترافي
MONGODB_TEST_OFFICE_PHONE=0550000000

# Public HTTPS origin for QR codes generated inside native builds.
# Leave empty on the hosted website to use its current public origin.
VITE_PUBLIC_APP_URL=
